# Copie este arquivo para .env e preencha. NUNCA faça commit do .env.

# ── Banco de dados (MySQL) ──
# O banco é criado sozinho se não existir, e as tabelas e migrações
# são aplicadas automaticamente quando o servidor liga.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cidigital
DB_CONNECTION_LIMIT=10
# fuso horário usado nas datas (Brasília = -03:00)
DB_TIMEZONE=-03:00

# ── Servidor ──
PORT=3000
FRONTEND_URL=http://localhost:3001
NODE_ENV=development

# ── Limites de requisições (opcional; estes são os padrões) ──
# RATE_LIMIT_USUARIO=120   # por usuário logado, por minuto
# RATE_LIMIT_IP=600        # por IP sem login, por minuto
# RATE_LOGIN_CONTA=5       # tentativas de login por conta, a cada 15 min
# RATE_LOGIN_IP=300        # tentativas de login por IP (todas as contas), a cada 15 min

# ── Autenticação ──
# Use um texto longo e aleatório (ex.: gerado com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRATION=8h

# ── Primeiro administrador (opcional) ──
# Usado só se o banco ainda não tiver nenhum administrador. Depois de criado, pode apagar a senha daqui.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=
# ADMIN_DEPARTAMENTO_ID=2
# ADMIN_USINA_ID=1

# ── E-mail (opcional) ──
# Sem essas variáveis, o código de recuperação de senha aparece só no terminal do servidor.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=C.I Digital Usina
